# AI Resume Screening System - Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider: anthropic | openai
LLM_PROVIDER=anthropic

# Model name for the chosen provider
# Anthropic: claude-sonnet-4-20250514
# OpenAI: gpt-4o
LLM_MODEL=

# API Keys (at least one required for LLM mode; not needed for --no-llm)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub personal access token (optional; raises rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Concurrency and timeouts
MAX_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=60
GITHUB_TIMEOUT_SECONDS=10

# Default paths
DEFAULT_INPUT_DIR=./resumes
DEFAULT_OUTPUT_PATH=./output/results.json
